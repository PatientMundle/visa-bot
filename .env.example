# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
GROQ_API_KEY=

# Bot Credentials
VISA_EMAIL="patientmundele17@gmail.com"
VISA_PASSWORD="Ordinateur@27"
VISA_APPLICATION_INDEX="1"
CHECK_INTERVAL_MS="300000" # 5 minutes by default

# Telegram Alerts Integration (API Bot Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database & Cryptography
DATABASE_URL=
DATABASE_ENCRYPTION_KEY=

# Rotating Proxies (Optionnel - liste d'adresses http/socks5 séparées par virgules ou retours à la ligne)
